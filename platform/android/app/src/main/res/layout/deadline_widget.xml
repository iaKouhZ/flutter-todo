<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/deadline_widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="5dp" android:layout_height="15dp"
            android:importantForAccessibility="no" android:background="@color/deadline_widget_accent" />
        <TextView android:id="@+id/widget_title"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="7dp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/deadline_widget_text"
            android:singleLine="true" android:ellipsize="end"
            android:textSize="14sp" android:text="@string/widget_title" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="5dp">
        <ListView android:id="@+id/widget_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:dividerHeight="0dp"
            android:scrollbars="vertical" android:scrollbarStyle="insideOverlay"
            android:clipToPadding="false" />
        <TextView android:id="@+id/widget_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="6dp" android:maxLines="3" android:ellipsize="end"
            android:text="@string/widget_loading"
            android:textColor="@color/deadline_widget_secondary_text" android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>

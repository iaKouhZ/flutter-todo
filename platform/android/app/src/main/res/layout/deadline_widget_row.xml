<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="30dp" android:paddingTop="5dp" android:paddingBottom="5dp"
    android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/widget_row_title"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:includeFontPadding="false"
        android:maxLines="2" android:ellipsize="end"
        android:textColor="@color/deadline_widget_text" android:textSize="13sp" />
    <TextView android:id="@+id/widget_row_deadline"
        android:layout_width="88dp" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:includeFontPadding="false"
        android:gravity="end" android:fontFeatureSettings="tnum"
        android:maxLines="2" android:ellipsize="end"
        android:textColor="@color/deadline_widget_secondary_text" android:textSize="11sp" />
</LinearLayout>
